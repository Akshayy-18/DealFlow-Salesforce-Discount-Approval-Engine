{
  "name": "dealflow-salesforce-discount-approval-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Salesforce discount policies, native approvals, and a browser-only learning demo",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test demo/tests/*.test.mjs mock-api/*.test.mjs",
    "mock-api": "node mock-api/server.mjs",
    "check:metadata": "python tools/check_metadata.py",
    "test:worker": "node --test cloudflare/worker.test.mjs",
    "deploy:worker": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  }
}
